spring.application.name=Backend-Warehouse

# ------------------------------------------------------------------------------
# Database Configuration (MySQL / TiDB)
# ------------------------------------------------------------------------------
# Local: jdbc:mysql://localhost:3306/warehouse?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# TiDB Cloud: jdbc:mysql://<tidb-host>:<port>/warehouse?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/your_database_name}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.username=${DB_USERNAME:your_db_username}
spring.datasource.password=${DB_PASSWORD:your_db_password}

# ------------------------------------------------------------------------------
# JPA / Hibernate
# ------------------------------------------------------------------------------
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

# ------------------------------------------------------------------------------
# Task Scheduling
# ------------------------------------------------------------------------------
spring.task.scheduling.enabled=true

# ------------------------------------------------------------------------------
# JWT Configuration
# ------------------------------------------------------------------------------
# Chuoi bi mat de ky token JWT (toi thieu 256 bits / 32 ky tu)
backend.warehouse.app.jwtSecret=${JWT_SECRET:your_jwt_secret_key_here}
backend.warehouse.app.jwtExpirationMs=86400000